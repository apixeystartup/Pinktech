# Pinktech Production Environment Template
# Copy this file to .env.production and fill in your actual values
# NEVER commit the actual .env.production file to GitHub

NODE_ENV=production
PORT=5001

# MongoDB Atlas Connection String
# Get this from: MongoDB Atlas → Database → Connect → Drivers
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.mongodb.net/pink_saas?appName=Cluster0

# JWT Secrets (generate random 64-char hex strings)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=GENERATE_RANDOM_64_CHAR_HEX_STRING_HERE
JWT_REFRESH_SECRET=GENERATE_RANDOM_64_CHAR_HEX_STRING_HERE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin Credentials
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=YourStr0ngPass123!
SUPER_ADMIN_NAME=Platform Super Admin

# Queues (disabled - not used in production)
QUEUES_ENABLED=false

# Email Mode (mock = no real emails sent)
EMAIL_MODE=mock

# Optional: Redis (not required)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional: SMTP (for real email sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=pass
SMTP_FROM=no-reply@example.com

# Optional: AWS S3 (for document storage)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=replace_bucket_name
