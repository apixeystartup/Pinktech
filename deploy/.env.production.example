# Pinktech Production Environment Template
# Copy this file to .env.production and fill in your actual values
# NEVER commit the actual .env.production file to GitHub

NODE_ENV=production
PORT=5001

# MongoDB Atlas Connection String
# Get this from: MongoDB Atlas → Database → Connect → Drivers
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.mongodb.net/pink_saas?appName=Cluster0

# JWT Secrets (generate random 64-char hex strings)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=GENERATE_RANDOM_64_CHAR_HEX_STRING_HERE
JWT_REFRESH_SECRET=GENERATE_RANDOM_64_CHAR_HEX_STRING_HERE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin Credentials
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=YourStr0ngPass123!
SUPER_ADMIN_NAME=Platform Super Admin

# Queues (disabled - not used in production)
QUEUES_ENABLED=false

# Email Mode
# mock = log only, never sends. Use "smtp" once provider credentials below exist.
EMAIL_MODE=smtp
EMAIL_FROM=no-reply@notify.approveit.online
# Ordered fail-over chain; first provider with quota headroom wins.
EMAIL_PROVIDERS=resend,brevo,mailjet,smtp2go,sendpulse
EMAIL_CHAIN_TIMEOUT_MS=20000

# Per-provider credentials (hosts/ports default in shared/src/mailProviders.js).
# A provider with credentials missing is skipped automatically, so you can roll
# them out one at a time. Quota caps default to each free tier and should only be
# overridden downward.
# Resend: password is the API key. Sending domain must be verified.
EMAIL_PROVIDER_RESEND_USER=resend
EMAIL_PROVIDER_RESEND_PASS=re_replace_me
# Brevo: username is your SMTP login; password must be an SMTP key.
EMAIL_PROVIDER_BREVO_USER=you@example.com
EMAIL_PROVIDER_BREVO_PASS=smtp-replace_me
# Mailjet: API key pair.
EMAIL_PROVIDER_MAILJET_USER=replace_me
EMAIL_PROVIDER_MAILJET_PASS=replace_me
# SMTP2GO: free plan allows only 5 verified senders.
EMAIL_PROVIDER_SMTP2GO_USER=you@example.com
EMAIL_PROVIDER_SMTP2GO_PASS=replace_me
# SendPulse: use the dedicated SMTP password from the SMTP settings page.
EMAIL_PROVIDER_SENDPULSE_USER=you@example.com
EMAIL_PROVIDER_SENDPULSE_PASS=replace_me

# Optional: Redis (not required)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional: AWS S3 (for document storage)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=replace_bucket_name

# Gateway rate limiting (protects the 1 GB origin and the Atlas Free op/sec budget)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=900000

# MongoDB pool sizing: 9 processes x 20 stays under the Atlas Free 500-connection cap
MONGO_MAX_POOL_SIZE=20
