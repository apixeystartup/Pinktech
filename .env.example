NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/pink_saas
JWT_ACCESS_SECRET=replace_access_secret_1234567890
JWT_REFRESH_SECRET=replace_refresh_secret_1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Platform Super Admin
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
QUEUES_ENABLED=false
EMAIL_MODE=mock
EMAIL_FROM=no-reply@notify.example.com
# Ordered fail-over chain. First provider with headroom wins; a provider is
# skipped once its daily/hourly free-tier cap is reached.
EMAIL_PROVIDERS=resend,brevo,mailjet,smtp2go,sendpulse
EMAIL_CHAIN_TIMEOUT_MS=20000
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=15000

# Per-provider credentials. Host/port default to the registry in
# shared/src/mailProviders.js, so only credentials are required.
# Resend: password is the API key. Verify the sending domain first.
EMAIL_PROVIDER_RESEND_USER=resend
EMAIL_PROVIDER_RESEND_PASS=re_replace_me
# Brevo: username is your SMTP login, password must be an SMTP key (not an API key).
EMAIL_PROVIDER_BREVO_USER=you@example.com
EMAIL_PROVIDER_BREVO_PASS=smtp-replace-me
# Mailjet: API key pair.
EMAIL_PROVIDER_MAILJET_USER=replace_me
EMAIL_PROVIDER_MAILJET_PASS=replace_me
# SMTP2GO: free plan allows only 5 verified senders.
EMAIL_PROVIDER_SMTP2GO_USER=you@example.com
EMAIL_PROVIDER_SMTP2GO_PASS=replace_me
# SendPulse: password is the dedicated SMTP password, not the dashboard password.
EMAIL_PROVIDER_SENDPULSE_USER=you@example.com
EMAIL_PROVIDER_SENDPULSE_PASS=replace_me
DEV_OTP=123456
AWS_REGION=ap-south-1
AWS_S3_BUCKET=replace_bucket_name
